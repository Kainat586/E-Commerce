generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  email        String?      @unique
  name         String?
  password     String?
  role         Role         @default(BUYER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       Order[]
  reviews      Reviews[]
  siteReviews  SiteReviews[]
  brands       Brand[]      // each seller can own multiple brands
  carts        Cart[]
}

enum Role {
  SELLER
  BUYER
}
model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sellerId  Int
  seller    User      @relation(fields: [sellerId], references: [id])
  products  Product[]
}
model Cart {
  id        Int       @id @default(autoincrement())
  userId    Int?      // NULL for guests
  guestId   String?   // for guest sessions
  productId Int
  quantity  Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User?     @relation(fields: [userId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
}


model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int       @default(0)
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  brandId     Int?
  brand       Brand?    @relation(fields: [brandId], references: [id])
  orders      Order[]
  reviews     Reviews[]
  carts       Cart[]
}

model Order {
  id          Int       @id @default(autoincrement())
  userId      Int?
  productId   Int
  quantity    Int       @default(1)
  totalPrice  Float
  customerName String?
  customerEmail String?
  customerPhone String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
}


model Reviews {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model SiteReviews {
  id        Int      @id @default(autoincrement())
  userId    Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}